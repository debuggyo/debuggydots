[
  {
    // Left Bar
    "name": "leftbar",
    "layer": "top",
    "position": "left",
    "margin": "5, 0, 5, 5",
    "width": 20,
    "reload_style_on_change": true,

    "modules-left": ["niri/workspaces"],
    "modules-center": ["niri/window"],
    "modules-right": ["tray", "custom/notification", "clock"],
    "include": ["~/.config/waybar/niri/modules.jsonc"],
  },
]
